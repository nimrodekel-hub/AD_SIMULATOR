    "html": "<style>\n.sim-console{--bezel1:#1a1f1b;--bezel2:#0d110e;--panel:#0a150e;--panel2:#0c1c12;--edge:#2f6b3f;--edge2:#1d4227;--ink:#8ee39a;--ink-dim:#4f8f5e;--ink-bright:#c9ffd4;--amber:#e0b83a;--red:#e0554a;--blue:#58a6ff;--grn:#6fe08a;box-sizing:border-box;display:flex;flex-direction:column;width:100%;height:100vh;max-height:100vh;overflow:hidden;padding:8px;background:radial-gradient(120% 90% at 50% 0%,#171c18 0%,#090c0a 70%);font-family:\"DejaVu Sans Mono\",\"Roboto Mono\",Consolas,monospace;color:var(--ink);font-size:12px;line-height:1.3;letter-spacing:.02em;-webkit-font-smoothing:antialiased}\n.sim-console *{box-sizing:border-box}\n.sim-console .bezel{flex:1;min-height:0;display:flex;flex-direction:column;gap:6px;padding:8px;border:2px solid #242a25;border-radius:7px;background:linear-gradient(180deg,var(--bezel1),var(--bezel2));box-shadow:inset 0 0 0 1px #000,inset 0 2px 16px rgba(0,0,0,.8)}\n.sim-console .screen{flex:1;min-height:0;display:flex;flex-direction:column;gap:6px;padding:7px;border:1px solid var(--edge);border-radius:3px;background:linear-gradient(180deg,#08120c,#050a07 60%,#07100b);box-shadow:inset 0 0 50px rgba(20,120,50,.10),inset 0 0 0 1px #0c2413}\n\n.sim-console .topbar{flex:0 0 auto;display:grid;grid-template-columns:minmax(210px,1fr) auto minmax(190px,auto);gap:10px;align-items:center;border:1px solid var(--edge2);background:linear-gradient(180deg,#0d1d12,#091209);padding:4px 9px;border-radius:2px}\n.sim-console .brand{display:flex;flex-direction:column;gap:1px;min-width:0}\n.sim-console [data-slot=\"system-name\"]{min-height:22px;min-width:190px;display:block;font-size:16px;letter-spacing:.10em;color:var(--ink-bright);text-shadow:0 0 8px rgba(110,230,140,.35)}\n.sim-console .brand .sub{font-size:9.5px;color:var(--ink-dim);letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sim-console .statechips{display:flex;align-items:center;gap:5px;flex-wrap:wrap;justify-content:center}\n.sim-console .chip{border:1px solid var(--edge2);padding:2px 8px;font-size:9.5px;letter-spacing:.11em;color:var(--ink-dim);background:#08130c;border-radius:2px;text-transform:uppercase;white-space:nowrap}\n.sim-console .chip.on{color:var(--ink-bright);border-color:var(--edge);background:#0f2a18;box-shadow:inset 0 0 10px rgba(80,200,110,.18)}\n.sim-console .clockwrap{display:flex;flex-direction:column;align-items:flex-end;gap:1px}\n.sim-console .clockwrap .lab{font-size:9px;letter-spacing:.16em;color:var(--ink-dim)}\n.sim-console [data-slot=\"clock\"]{min-height:26px;min-width:170px;display:block;padding:1px 7px;border:1px solid var(--edge);background:#061009;font-size:17px;font-variant-numeric:tabular-nums;color:var(--amber);text-align:right;text-shadow:0 0 8px rgba(224,184,58,.3)}\n\n.sim-console .main{flex:1;min-height:0;display:grid;gap:6px;grid-template-columns:164px minmax(260px,.85fr) minmax(500px,1.75fr) 272px;grid-template-areas:\"rail scope picture res\"}\n.sim-console .rail{grid-area:rail;display:flex;flex-direction:column;gap:6px;min-width:0;min-height:0}\n.sim-console .scope{grid-area:scope;min-width:0;min-height:0}\n.sim-console .picture{grid-area:picture;min-width:0;min-height:0}\n.sim-console .right{grid-area:res;display:flex;flex-direction:column;gap:6px;min-width:0;min-height:0}\n\n.sim-console .panel{display:flex;flex-direction:column;min-height:0;border:1px solid var(--edge2);border-radius:2px;background:linear-gradient(180deg,var(--panel2),var(--panel));box-shadow:inset 0 0 0 1px rgba(0,0,0,.5)}\n.sim-console .panel>.hd{flex:0 0 auto;display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding:3px 8px;border-bottom:1px solid var(--edge2);background:linear-gradient(180deg,#123321,#0b1e12);font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-bright)}\n.sim-console .panel>.hd .r{font-size:9px;letter-spacing:.08em;color:var(--ink-dim);text-transform:none;white-space:nowrap}\n.sim-console .panel>.bd{flex:1;display:flex;flex-direction:column;min-height:0;padding:6px}\n\n.sim-console .kv{display:flex;justify-content:space-between;gap:8px;font-size:10.5px;padding:1px 0;border-bottom:1px dotted #14351f}\n.sim-console .kv:last-child{border-bottom:0}\n.sim-console .kv b{color:var(--ink-bright);font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sim-console .kv span{color:var(--ink-dim)}\n.sim-console .grouplab{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);margin:5px 0 1px;border-bottom:1px solid var(--edge2)}\n.sim-console .grouplab:first-child{margin-top:0}\n\n.sim-console .scopewrap{flex:1;display:flex;align-items:center;justify-content:center;min-height:170px;padding:1px}\n.sim-console .scopewrap svg{width:100%;height:100%;display:block}\n.sim-console .scopefoot{flex:0 0 auto;display:grid;grid-template-columns:1fr 1fr;gap:0 8px;padding-top:4px;border-top:1px solid var(--edge2);font-size:9px;color:var(--ink-dim);letter-spacing:.05em}\n\n.sim-console .fieldorder{flex:0 0 auto;display:flex;border-bottom:1px solid var(--edge2);padding:0 2px 4px;font-size:9.5px;color:var(--ink-dim);letter-spacing:.09em;text-transform:uppercase;flex-wrap:wrap}\n.sim-console .fieldorder i{font-style:normal;padding-right:13px;white-space:nowrap}\n.sim-console [data-slot=\"tracks\"]{flex:1;display:block;min-height:210px;min-width:0;margin-top:3px;padding:2px;overflow:auto;background:repeating-linear-gradient(180deg,rgba(30,90,50,.07) 0 20px,transparent 20px 40px)}\n\n.sim-console [data-slot=\"resources\"]{flex:1;display:block;min-height:170px;padding:2px;overflow:auto}\n\n.sim-console .legend{display:flex;flex-direction:column;gap:2px}\n.sim-console .lrow{display:grid;grid-template-columns:12px 1fr auto;gap:6px;align-items:center;font-size:10.5px;padding:1px 0}\n.sim-console .sw{width:11px;height:11px;border:1px solid rgba(255,255,255,.25);border-radius:1px}\n.sim-console .sw.f{background:var(--blue);box-shadow:0 0 6px rgba(88,166,255,.5)}\n.sim-console .sw.g{background:var(--grn);box-shadow:0 0 6px rgba(111,224,138,.45)}\n.sim-console .sw.n{background:var(--amber);box-shadow:0 0 6px rgba(224,184,58,.45)}\n.sim-console .sw.h{background:var(--red);box-shadow:0 0 6px rgba(224,85,74,.5)}\n.sim-console .lrow b{font-weight:500;color:var(--ink-bright)}\n.sim-console .lrow em{font-style:normal;font-size:8.5px;letter-spacing:.08em;color:var(--ink-dim);text-transform:uppercase}\n\n.sim-console .footer{flex:0 0 auto;display:flex;flex-direction:column;gap:5px}\n.sim-console .decision>.bd{gap:4px;padding:5px 6px}\n.sim-console .seqhint{flex:0 0 auto;display:flex;flex-wrap:wrap;gap:4px;font-size:8.5px;letter-spacing:.09em;color:var(--ink-dim);text-transform:uppercase}\n.sim-console .seqhint u{text-decoration:none;border:1px solid var(--edge2);padding:1px 6px;border-radius:2px;background:#08130c}\n.sim-console [data-slot=\"decision\"]{display:block;min-height:96px;padding:2px;overflow:auto}\n\n.sim-console .keyrow{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center}\n.sim-console .fkeys{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:4px}\n.sim-console .fkey{padding:3px 0;text-align:center;font-size:10.5px;letter-spacing:.05em;border:1px solid var(--edge2);border-radius:2px;background:linear-gradient(180deg,#0e2415,#081209);color:var(--ink-dim);box-shadow:inset 0 1px 0 rgba(120,220,150,.06)}\n.sim-console .fkey.act{color:#04170a;background:linear-gradient(180deg,#8fe6a2,#4fae66);border-color:#8fe6a2}\n.sim-console .fkey.off{color:#27452f;border-color:#152b1b}\n.sim-console .plate{padding:2px 12px;border:1px solid #4a3f1e;border-radius:2px;background:linear-gradient(180deg,#3a3117,#221c0d);color:#c9b26a;font-size:8.5px;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap}\n\n@media (max-width:1420px){\n.sim-console .main{grid-template-columns:158px minmax(420px,1.7fr) 262px;grid-template-rows:minmax(0,1.35fr) minmax(0,1fr);grid-template-areas:\"rail picture res\" \"rail scop